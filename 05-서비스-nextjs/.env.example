# ─────────────────────────────────────────────────────────────
#  이 파일을 .env.local 로 복사한 뒤 값만 바꾸면 연동이 켜집니다.
#    cp .env.example .env.local
#
#  .env.local 은 git 에 올라가지 않습니다(.gitignore 의 .env*.local).
#  비워두면 연동만 꺼지고 사이트는 그대로 동작합니다 — 값 없이도 화면이 죽지 않게 짰습니다.
#  NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저로 내려갑니다. 비밀키를 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# pluug 리드 폼 주소
#   문의 데이터는 우리 DB 에 저장하지 않고 pluug 가 받습니다.
#   pluug 대시보드 > 폼 > 공유 링크에서 복사하세요.
#   ⚠ www 를 붙인 정규 주소를 쓰세요. pluuug.com/form/... 은 301 로 www 에 넘기는데
#     리다이렉트를 한 번 더 타면 그만큼 이탈 지점이 늘고 UTM 전달도 한 단계 더 거칩니다.
#   ⚠ pluug 쪽 "제출 후 이동 링크"를 이 사이트의 /submit 으로 맞춰야
#     전환 측정이 성립합니다.
NEXT_PUBLIC_PLUUG_FORM_URL=https://www.pluuug.com/form/여기에_폼_ID

# 채널톡 플러그인 키
#   채널톡 > 채널 설정 > 보안 및 개발 > 플러그인 키
#   ⚠ 키가 틀리면 boot 콜백이 아예 오지 않습니다. 에러도 안 납니다(실측).
#     바꾼 뒤에는 반드시 런처를 눌러 메신저가 실제로 열리는지 확인하세요.
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=여기에_플러그인_키

# pluug 로 넘길 utm_source 고정값. 보통 바꿀 일 없습니다.
NEXT_PUBLIC_UTM_SOURCE=ai-builder-group

# 실도메인이 정해지면 채우세요. 비우면 Vercel 프로덕션 도메인을 자동으로 씁니다.
#   og:url · og:image · canonical 이 모두 이 값을 따릅니다.
# NEXT_PUBLIC_SITE_URL=https://example.com

# GA4 측정 ID (TR-01 · IR-05)
#   ⚠ 반드시 **클라이언트 계정**에서 발급받은 값을 넣습니다. 우리 계정을 만들지 않습니다.
#     GA4 > 관리 > 데이터 스트림 > 웹 스트림 > 측정 ID (G- 로 시작)
#   비우면 gtag.js 를 아예 싣지 않습니다 — 개발·프리뷰 트래픽이 실계정 지표에 섞이지 않게.
#   넣은 뒤에는 GA4 > 관리 > DebugView 에서 이벤트 7종을 눈으로 확인하세요 (TR-02).
NEXT_PUBLIC_GA_ID=

# ── Supabase (어드민 인증 · 콘텐츠 저장) ─────────────────────
#   Supabase > Project Settings > API 에서 복사합니다.
#   ⚠ 둘 다 넣거나 둘 다 비워야 합니다. 하나만 채우면 빌드가 즉시 실패합니다 —
#     반쯤 설정된 상태는 "로그인 화면은 뜨는데 요청만 실패"로 나타나서 원인을 찾기 어렵습니다.
#   비워두면 /admin 이 목업(로그인·저장 없음)으로 남고, 공개 페이지는 영향받지 않습니다.
#   🔴 비워둔 동안 /admin 은 아무나 들어옵니다. 실데이터를 넣기 전에 키를 채우세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 구글 로그인 (FR-A01-01) ──────────────────────────────────
#   여기 넣을 값은 없습니다. 전부 콘솔 설정이라 순서만 적어 둡니다.
#
#   1) Google Cloud > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹)
#      승인된 리디렉션 URI = https://<프로젝트>.supabase.co/auth/v1/callback
#      ⚠ 우리 도메인이 아니라 **Supabase 주소**입니다. 여기서 가장 많이 틀립니다.
#   2) Supabase > Authentication > Providers > Google 켜기 + 위 클라이언트 ID·시크릿 붙여넣기
#   3) Supabase > Authentication > URL Configuration > Redirect URLs 에 추가:
#        http://localhost:3000/auth/callback
#        https://<프로덕션-도메인>/auth/callback
#        https://*.vercel.app/auth/callback     (프리뷰 배포용)
#      허용 목록에 없는 주소로는 돌아오지 못합니다 — Host 헤더 위조에 대한 실제 방어선입니다.
#   4) supabase/schema.sql 의 §10 을 실행합니다. 첫 로그인에 builders 행을 이어 주는
#      트리거입니다. 없으면 "로그인은 되는데 아무것도 안 보이는" 상태가 됩니다.
#
#   계정은 여전히 관리자가 발급합니다 (FR-A01-02). builders 에 이메일이 없는 구글 계정은
#   콜백에서 세션이 즉시 삭제되고 "발급된 계정이 없습니다" 로 되돌아갑니다.

# 🔴 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 마세요 — 붙이는 순간 브라우저 번들에 들어가고,
#    이 키는 RLS 를 통째로 우회합니다 (NFR-12). Vercel 환경변수에만 넣습니다.
#    지금 코드는 이 키를 쓰지 않습니다. 초대 메일 발송 같은 관리자 전용 작업에서 필요해집니다.
# SUPABASE_SERVICE_ROLE_KEY=
